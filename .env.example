# Optional root .env. Public local-development defaults ONLY, not production secrets.
# Exported environment variables override this file; explicitly empty values fail.
POSTGRES_USER=gethookd
POSTGRES_PASSWORD=gethookd
POSTGRES_DB=gethookd
JWT_SECRET=gethookd-public-development-secret-do-not-use-in-production
# Independent server-only cursor secret, at least 32 UTF-8 bytes; never reuse JWT/API keys.
CURSOR_SECRET=gethookd-public-development-cursor-secret-do-not-use-in-production
# Keep stable across API restarts. Changing it invalidates existing cursors.
# Rotate after database restore/replacement; clients must start fresh searches.

# Leave DATABASE_URL unset to derive an encoded URL from the POSTGRES_* settings.
# Host commands default to localhost:5432; container consumers use db:5432.
# An explicit URL is used unchanged and must be reachable from its context.
# Host example:
# DATABASE_URL=postgresql://gethookd:gethookd@localhost:5432/gethookd
# Container example (not reachable from host commands):
# DATABASE_URL=postgresql://gethookd:gethookd@db:5432/gethookd
# Percent-encode reserved characters in explicit URL credentials/database names.
# Single-quote .env values containing #, spaces, or $ (no interpolation).
# Do not use DATABASE_URL= to unset.
# POSTGRES_* only provisions a fresh Compose DB volume. It does not modify users
# or passwords in an existing volume, or a separate database targeted by a URL.
