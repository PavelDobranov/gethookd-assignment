          "name": "ads_status_end_date_check",
          "value": "(\"ads\".\"status\" = 'active' AND \"ads\".\"end_date\" IS NULL) OR (\"ads\".\"status\" = 'inactive' AND \"ads\".\"end_date\" IS NOT NULL)"
